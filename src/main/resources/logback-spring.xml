<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ==================== ПЕРЕМЕННЫЕ ==================== -->
    <property name="LOGS_DIR" value="./logs" />
    <property name="MAX_FILE_SIZE" value="100MB" />
    <property name="MAX_HISTORY" value="30" />
    <property name="TOTAL_SIZE_CAP" value="2GB" />

    <!-- ==================== DEV АППЕНДЕРЫ ==================== -->
    <appender name="DEV_APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS_DIR}/dev/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS_DIR}/dev/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="DEV_ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS_DIR}/dev/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS_DIR}/dev/error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ==================== TEST АППЕНДЕРЫ ==================== -->
    <appender name="TEST_APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS_DIR}/test/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS_DIR}/test/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="TEST_ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS_DIR}/test/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS_DIR}/test/error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ==================== PROD АППЕНДЕРЫ ==================== -->
    <appender name="PROD_APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS_DIR}/prod/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS_DIR}/prod/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="PROD_ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS_DIR}/prod/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS_DIR}/prod/error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ==================== ПРОФИЛЬ DEV ==================== -->
    <springProfile name="dev">
        <root level="DEBUG">
            <appender-ref ref="DEV_APP_FILE" />
            <appender-ref ref="DEV_ERROR_FILE" />
        </root>
        <logger name="com.example.searchengine" level="DEBUG" additivity="false">
            <appender-ref ref="DEV_APP_FILE" />
            <appender-ref ref="DEV_ERROR_FILE" />
        </logger>
        <!-- ⚠️ Отключаем шумные DEBUG-логи Hibernate -->
        <logger name="org.hibernate.engine.internal.Collections" level="WARN"/>
        <logger name="org.hibernate.internal.util.EntityPrinter" level="WARN"/>
        <logger name="org.hibernate.engine.internal.AbstractFlushingEventListener" level="WARN"/>
    </springProfile>

    <!-- ==================== ПРОФИЛЬ TEST ==================== -->
    <springProfile name="test">
        <root level="WARN">
            <appender-ref ref="TEST_APP_FILE" />
            <appender-ref ref="TEST_ERROR_FILE" />
        </root>
        <logger name="com.example.searchengine" level="DEBUG" additivity="false">
            <appender-ref ref="TEST_APP_FILE" />
            <appender-ref ref="TEST_ERROR_FILE" />
        </logger>
        <!-- ⚠️ Отключаем шумные DEBUG-логи Hibernate -->
        <logger name="org.hibernate.engine.internal.Collections" level="WARN"/>
        <logger name="org.hibernate.internal.util.EntityPrinter" level="WARN"/>
        <logger name="org.hibernate.engine.internal.AbstractFlushingEventListener" level="WARN"/>
    </springProfile>

    <!-- ==================== ПРОФИЛЬ PROD ==================== -->
    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="PROD_APP_FILE" />
            <appender-ref ref="PROD_ERROR_FILE" />
        </root>
        <logger name="com.example.searchengine" level="INFO" additivity="false">
            <appender-ref ref="PROD_APP_FILE" />
            <appender-ref ref="PROD_ERROR_FILE" />
        </logger>
    </springProfile>

    <!-- ==================== ПРОФИЛЬ ПО УМОЛЧАНИЮ ==================== -->
    <springProfile name="default">
        <root level="DEBUG">
            <appender-ref ref="DEV_APP_FILE" />
            <appender-ref ref="DEV_ERROR_FILE" />
        </root>
        <!-- ⚠️ Отключаем шумные DEBUG-логи Hibernate -->
        <logger name="org.hibernate.engine.internal.Collections" level="WARN"/>
        <logger name="org.hibernate.internal.util.EntityPrinter" level="WARN"/>
        <logger name="org.hibernate.engine.internal.AbstractFlushingEventListener" level="WARN"/>
    </springProfile>

</configuration>

