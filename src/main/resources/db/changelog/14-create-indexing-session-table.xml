<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="14-create-indexing-session-table" author="midl">
        <comment>
            Таблица истории сессий индексации.
            Одна строка = одна сессия (запуск/остановка/завершение).
            Используется в админ-панели для отображения истории.
        </comment>

        <createTable tableName="indexing_session">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="started_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="ended_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="mode" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="total_sites" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_pages" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_lemmas" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_errors" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="duration_seconds" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="started_by" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="indexing_session" indexName="idx_session_started_at">
            <column name="started_at"/>
        </createIndex>

        <createIndex tableName="indexing_session" indexName="idx_session_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>